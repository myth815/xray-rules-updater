  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ruleTag": "ai66-dns-intercept",
        "inboundTag": [
          "ai66-dns-in"
        ],
        "outboundTag": "ai66-dns-out"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
