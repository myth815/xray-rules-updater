        ],
        "outboundTag": "ai-guard-loop-socks-general"
      },
      {
        "type": "field",
        "ruleTag": "ai66-second-pass-tunIn",
        "inboundTag": [
          "tunIn"
        ],
        "outboundTag": "ai-guard-loop-tunIn"
      },
      {
        "type": "field",
        "ruleTag": "ai66-local-ip",
        "inboundTag": [
          "http-daily",
          "socks-daily",
          "ai-guard-second-daily",
          "http-usa-ai",
          "socks-usa-ai"
        ],
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ruleTag": "ai66-local-domain",
        "inboundTag": [
          "http-daily",
          "socks-daily",
          "ai-guard-second-daily",
          "http-usa-ai",
          "socks-usa-ai"
        ],
        "domain": [
          "full:router.synthetic.invalid",
          "full:media.synthetic.invalid"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ruleTag": "ai66-force-us",
        "inboundTag": [
          "http-usa-ai",
          "socks-usa-ai"
        ],
        "outboundTag": "usa-ai"
      },
      {
        "type": "field",
        "ruleTag": "ai66-force-daily",
        "inboundTag": [
          "http-daily",
          "socks-daily",
          "ai-guard-second-daily"
        ],
        "outboundTag": "daily-overseas"
      },
      {
        "type": "field",
        "domain": [
          "domain:cn.example.invalid"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:!cn"
        ],
        "outboundTag": "daily-overseas"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
