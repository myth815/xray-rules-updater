      },
      {
        "type": "field",
        "domain": [
          "domain:ai.example.invalid"
        ],
        "outboundTag": "usa-ai"
      },
      {
        "type": "field",
        "ruleTag": "ai66-fake-protocol-block",
        "protocol": [
          "fakedns"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ruleTag": "ai66-fake-ip-block",
        "ip": [
          "198.19.0.0/16"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ruleTag": "ai66-second-pass-socks-route",
